
NODE_ENV=production
PORT=3000

# PostgreSQL
DATABASE_URL=
PGSSL=true

# Administration : utilise une clé longue et aléatoire
ADMIN_KEY=

# Marge minimale par article en USD
PRICE_MARKUP_USD=10

# URL publique réelle du service Render
PUBLIC_BASE_URL=

# Intelligence IA (facultatif si le mode local est disponible)
ANTHROPIC_API_KEY=

# CamerPay : secret officiel de validation des callbacks
CAMERPAY_CALLBACK_SECRET=

# Email : complète uniquement avec les valeurs réellement configurées
RESEND_API_KEY=
RESEND_FROM=
